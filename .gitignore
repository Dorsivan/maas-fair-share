# Go
/bin/
/dist/
*.exe
*.test
*.out
vendor/

# ...except these two: conformance/gatewayheaders and cmd/gateway-header-check
# are separate Go modules (see their go.mod headers and
# docs/gateway-header-stripping.md, "Building this check air-gapped") whose
# vendor/ directories are committed on purpose, so the UNI-33 conformance
# check builds with no network access. This does not reopen vendoring for the
# root module's EPP build, which still deliberately compiles against
# llm-d-router unvendored (docs/version-pinning.md).
!/conformance/gatewayheaders/vendor/
!/conformance/gatewayheaders/vendor/**
!/cmd/gateway-header-check/vendor/
!/cmd/gateway-header-check/vendor/**

# Python (prototype/ only -- frozen reference, see prototype/README.md)
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Generated protobuf stubs: reproduce with prototype/wfq_service/compile_protos.sh
prototype/wfq_service/generated/

# Load-test output
results/

# Local tooling / editor
.claude/settings.local.json
.idea/
.vscode/
*.swp
.DS_Store

# IBM Cloud operator tooling (local only -- never commit)
# Operator guide, login helper, and the installable subagent brief.
/.ibmcloud/
/.claude/agents/
# Defence in depth: never commit a credential even if the paths above change.
**/apikey.json
**/*.apikey
